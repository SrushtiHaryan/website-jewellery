# ============================================================
# Aurelia Jewellery — Environment Variables (example)
# Copy this file to backend/.env and frontend/.env.local and fill in values.
# NEVER commit real credentials.
# ============================================================

# ---- Core ----
NODE_ENV=development
PORT=5000

# Client & server origins (used for CORS, emails, canonical URLs)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# ---- Database ----
# Leave MONGODB_URI empty in development to auto-start an in-memory MongoDB
# (mongodb-memory-server). For production, set a real connection string:
#   mongodb+srv://user:pass@cluster.mongodb.net/aurelia
MONGODB_URI=

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cloudinary (image storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (transactional) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Aurelia Jewellery <no-reply@aurelia.example>"

# ---- Frontend (Next.js) — put these in frontend/.env.local ----
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
